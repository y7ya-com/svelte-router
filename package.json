{
  "name": "@tanstack/svelte-router",
  "version": "0.0.3-experimental",
  "description": "TanStack Router for Svelte 5 — experimental community port; not an official TanStack release. API mirrors @tanstack/solid-router.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/y7ya-com/router.git",
    "directory": "packages/svelte-router"
  },
  "homepage": "https://github.com/y7ya-com/router/tree/feat/svelte-router/packages/svelte-router",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/tannerlinsley"
  },
  "keywords": [
    "tanstack",
    "tanstack-router",
    "svelte",
    "svelte5",
    "svelte-router",
    "router",
    "routing",
    "file-based-routing",
    "type-safe",
    "type-safe-router",
    "client-side-routing",
    "spa",
    "community-port"
  ],
  "scripts": {},
  "type": "module",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": {
        "development": "./dist/index.dev.js",
        "default": "./dist/index.js"
      },
      "development": "./dist/index.dev.js",
      "import": "./dist/index.js"
    },
    "./ssr/server": {
      "types": "./dist/ssr/server.d.ts",
      "svelte": "./dist/ssr/server.js",
      "import": "./dist/ssr/server.js"
    },
    "./ssr/client": {
      "types": "./dist/ssr/client.d.ts",
      "svelte": "./dist/ssr/client.js",
      "import": "./dist/ssr/client.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@tanstack/history": "^1.162.0",
    "@tanstack/router-core": "^1.171.15",
    "@tanstack/svelte-store": "^0.12.0",
    "isbot": "^5.1.22"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}
