{
  "name": "@tanstack/svelte-router",
  "version": "0.0.8-experimental",
  "description": "Modern and scalable routing for Svelte applications",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanStack/router.git",
    "directory": "packages/svelte-router"
  },
  "homepage": "https://github.com/TanStack/router/tree/main/packages/svelte-router",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/tannerlinsley"
  },
  "keywords": [
    "tanstack",
    "tanstack-router",
    "svelte",
    "svelte5",
    "svelte-router",
    "router",
    "routing",
    "file-based-routing",
    "type-safe",
    "type-safe-router",
    "client-side-routing",
    "spa"
  ],
  "scripts": {},
  "type": "module",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "svelte": {
          "development": "./dist/index.dev.js",
          "default": "./dist/index.js"
        },
        "development": "./dist/index.dev.js",
        "default": "./dist/index.js"
      }
    },
    "./ssr/server": {
      "import": {
        "types": "./dist/ssr/server.d.ts",
        "svelte": "./dist/ssr/server.js",
        "default": "./dist/ssr/server.js"
      }
    },
    "./ssr/client": {
      "import": {
        "types": "./dist/ssr/client.d.ts",
        "svelte": "./dist/ssr/client.js",
        "default": "./dist/ssr/client.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@tanstack/history": "^1.162.4",
    "@tanstack/router-core": "^1.171.34",
    "@tanstack/svelte-store": "^0.12.0",
    "isbot": "^5.1.22"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}
